<UserControl x:Class="DynamicIsland.Widgets.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="MessageText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <Grid x:Name="ReportPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path x:Name="CurrentIcon"
                  Width="56" Height="56"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource TextPrimaryBrush}"
                  Stretch="Uniform" />

            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="TemperatureText"
                           FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="DescriptionText"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CityText"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="ForecastPanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
        </Grid>
    </Grid>
</UserControl>
