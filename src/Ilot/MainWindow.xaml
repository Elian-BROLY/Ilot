<Window x:Class="Ilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:Ilot.Widgets"
        xmlns:controls="clr-namespace:Ilot.Controls"
        Title="Ilot"
        Width="468" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}">

    <!-- La fenêtre garde une taille fixe : ses pixels transparents laissent passer les clics,
         et seule la capsule s'anime à l'intérieur, ce qui supprime tout sautillement. -->
    <Grid x:Name="RootGrid" Width="468" Height="240">
        <Border x:Name="CapsuleShadow"
                Width="{Binding ActualWidth, ElementName=Capsule}"
                Height="{Binding ActualHeight, ElementName=Capsule}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#0D0D0D"
                CornerRadius="24"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Hidden">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.45" />
            </Border.Effect>
        </Border>

        <Border x:Name="Capsule"
                Width="180" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="16"
                BorderThickness="0"
                MouseEnter="Capsule_MouseEnter"
                MouseLeave="Capsule_MouseLeave"
                MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
                MouseMove="Capsule_MouseMove"
                MouseLeftButtonUp="Capsule_MouseLeftButtonUp"
                LostMouseCapture="Capsule_LostMouseCapture"
                PreviewMouseWheel="Capsule_PreviewMouseWheel"
                AllowDrop="True"
                DragEnter="Capsule_DragEnter"
                DragLeave="Capsule_DragLeave"
                Drop="Capsule_Drop">
            <Border.Background>
                <SolidColorBrush x:Name="CapsuleFill" Color="#0D0D0D" />
            </Border.Background>

            <Grid ClipToBounds="True">
                <!-- État compact -->
                <Grid x:Name="CompactContent"
                      Width="180" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel x:Name="CompactCenter" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock x:Name="ClockText"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="CompactTemperatureText"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <controls:EqualizerBars x:Name="PlayingIndicator"
                                            Margin="14,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                    <TextBlock x:Name="CompactTimerText"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="Collapsed" />
                    <StackPanel x:Name="CompactRight"
                                Margin="0,0,14,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Ellipse x:Name="CompactMicDot"
                                 Width="7" Height="7"
                                 Margin="0,0,4,0"
                                 VerticalAlignment="Center"
                                 Fill="#FF9F0A"
                                 AutomationProperties.Name="Micro utilisé"
                                 Visibility="Collapsed" />
                        <Ellipse x:Name="CompactCameraDot"
                                 Width="7" Height="7"
                                 Margin="0,0,4,0"
                                 VerticalAlignment="Center"
                                 Fill="#30D158"
                                 AutomationProperties.Name="Caméra utilisée"
                                 Visibility="Collapsed" />
                        <StackPanel x:Name="MailIndicator"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="&#xE715;" />
                            <TextBlock x:Name="MailCountText"
                                       Margin="3,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Path x:Name="AirPodsIndicator"
                              Width="14" Height="14"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Data="{StaticResource AirPodsGeometry}"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              Stretch="Uniform"
                              Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- Bannière de connexion, en forme de capsule. -->
                <Grid x:Name="BannerPanel"
                      Width="360" Height="60"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Background="Transparent"
                      Opacity="0"
                      Visibility="Collapsed"
                      MouseLeftButtonDown="BannerPanel_MouseLeftButtonDown"
                      MouseLeftButtonUp="BannerPanel_MouseLeftButtonUp">
                    <Grid Margin="16,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="BannerAirPodsIcon"
                              Width="28" Height="28"
                              Data="{StaticResource AirPodsGeometry}"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              Stretch="Uniform" />
                        <Border x:Name="BannerMailMark"
                                Width="32" Height="32"
                                Background="{DynamicResource HoverBrush}"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="BannerMailLetter"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Image x:Name="BannerAppIcon"
                                       Width="24" Height="24"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BannerNameText"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BannerStatusText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <controls:AirPodsBatteryRings x:Name="BannerRings"
                                                      Grid.Column="2"
                                                      VerticalAlignment="Center" />
                        <TextBlock x:Name="BannerExtraText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- État étendu : taille fixe pour ne jamais recalculer sa mise en page pendant l'animation. -->
                <Grid x:Name="ExpandedPanel"
                      Width="420" Height="160"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0"
                      Visibility="Collapsed">
                    <Grid Margin="14,12,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="106" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>

                        <!-- Une seule page visible à la fois : les pages masquées ne consomment rien. -->
                        <Grid x:Name="PageHost" ClipToBounds="True">
                            <widgets:MediaWidget x:Name="MediaPanel" Visibility="Collapsed" />
                            <widgets:WeatherWidget x:Name="WeatherPanel" Visibility="Collapsed" />
                            <widgets:MailWidget x:Name="MailPanel" Visibility="Collapsed" />
                            <widgets:AudioWidget x:Name="AudioPanel" Visibility="Collapsed" />
                            <widgets:TimerWidget x:Name="TimerPanel" Visibility="Collapsed" />
                            <widgets:NoteWidget x:Name="NotePanel" Visibility="Collapsed" />
                            <widgets:AppVolumeWidget x:Name="AppVolumePanel" Visibility="Collapsed" />
                            <widgets:SystemStatsWidget x:Name="SystemStatsPanel" Visibility="Collapsed" />
                            <widgets:CalendarWidget x:Name="CalendarPanel" Visibility="Collapsed" />
                            <widgets:FilesWidget x:Name="FilesPanel" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="PageDots"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <widgets:SystemWidget x:Name="SystemPanel" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse x:Name="ExpandedMicDot"
                                         Width="7" Height="7"
                                         Margin="0,0,4,0"
                                         Fill="#FF9F0A"
                                         ToolTip="Micro en cours d'utilisation"
                                         Visibility="Collapsed" />
                                <Ellipse x:Name="ExpandedCameraDot"
                                         Width="7" Height="7"
                                         Fill="#30D158"
                                         ToolTip="Caméra en cours d'utilisation"
                                         Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="OutputButton"
                                    Grid.Column="2"
                                    Width="24" Height="24"
                                    Margin="6,0,0,0"
                                    FontSize="12"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE7F6;"
                                    ToolTip="Choisir la sortie audio"
                                    AutomationProperties.Name="Choisir la sortie audio"
                                    Click="OutputButton_Click" />
                            <TextBlock x:Name="ExpandedClockText"
                                       Grid.Column="3"
                                       Margin="8,0,10,0"
                                       VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="PinGlyph"
                                       Grid.Column="4"
                                       Margin="0,0,2,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="&#xE718;" />
                        </Grid>

                        <widgets:AirPodsWidget x:Name="AirPodsPanel"
                                               Grid.Row="3" Grid.ColumnSpan="2"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
