<Window x:Class="Ilot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réglages d'Ilot"
        Width="520" Height="640"
        MinWidth="440" MinHeight="400"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TabContent" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="16,14,16,0" />
        </Style>
    </Window.Resources>

    <TabControl Margin="4,4,4,0">
        <TabItem Header="Général">
            <ScrollViewer Style="{StaticResource TabContent}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Pages" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,6"
                                       Text="Cochez les pages à afficher et réglez leur ordre. Dans la capsule, changez de page avec la molette ou les points à droite." />
                            <StackPanel x:Name="PagesList" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Écran et position" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ComboBox x:Name="ScreenCombo"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Écran d'affichage"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="Screen_SelectionChanged" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Recentrer" Click="Recenter_Click" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Text="Pour déplacer la capsule, glissez-la latéralement à la souris." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Système" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutostartCheck" Content="Lancer Ilot au démarrage de Windows"
                                      Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                            <CheckBox x:Name="FullscreenCheck" Content="Masquer la capsule en plein écran (jeux, vidéos)"
                                      Checked="Options_Changed" Unchecked="Options_Changed" />
                            <CheckBox x:Name="GlobalHotkeyCheck" Content="Activer les raccourcis clavier"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource Hint}"
                                       Margin="28,0,0,0"
                                       Text="Au moins un de ces raccourcis est déjà utilisé par une autre application."
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Raccourcis clavier" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,6"
                                       Text="Cliquez dans un champ puis appuyez sur la combinaison voulue, avec Ctrl, Alt ou Win." />
                            <StackPanel x:Name="HotkeysList" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Rétablir" Click="ResetHotkeys_Click" />
                                <TextBlock x:Name="HotkeysConflictText" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Casque" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="HeadsetRowCheck" Content="Afficher la ligne du casque dans le panneau"
                                      Checked="Headset_Changed" Unchecked="Headset_Changed" />
                            <ComboBox x:Name="HeadsetCombo"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Casque affiché"
                                      SelectionChanged="Headset_Changed" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Météo" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Valider" IsDefault="True" Click="ValidateCity_Click" />
                                <TextBox x:Name="CityBox"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Ville" />
                            </DockPanel>
                            <ComboBox x:Name="CityChoicesCombo"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Ville exacte"
                                      DisplayMemberPath="Label"
                                      Visibility="Collapsed"
                                      SelectionChanged="CityChoice_Changed" />
                            <TextBlock x:Name="CityStatusText"
                                       Style="{StaticResource Hint}"
                                       Margin="0,6,0,0"
                                       Text="Le nom de la ville est envoyé au service Open-Meteo pour trouver ses prévisions." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Apparence">
            <ScrollViewer Style="{StaticResource TabContent}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Couleurs et taille" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Langue" />
                            <ComboBox x:Name="LanguageCombo" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Langue"
                                      SelectionChanged="Language_Changed">
                                <ComboBoxItem Content="Suivre Windows" Tag="" />
                                <ComboBoxItem Content="Français" Tag="fr" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                            <TextBlock VerticalAlignment="Center" Text="Thème" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Thème"
                                      SelectionChanged="Appearance_SelectionChanged">
                                <ComboBoxItem Content="Sombre" />
                                <ComboBoxItem Content="Clair" />
                                <ComboBoxItem Content="Suivre Windows" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Couleur d'accent" />
                            <ComboBox x:Name="AccentCombo" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Couleur d'accent"
                                      SelectionChanged="Appearance_SelectionChanged" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Taille de la capsule" />
                            <ComboBox x:Name="SizeCombo" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Taille de la capsule"
                                      SelectionChanged="Appearance_SelectionChanged">
                                <ComboBoxItem Content="Petite" Tag="0.85" />
                                <ComboBoxItem Content="Normale" Tag="1" />
                                <ComboBoxItem Content="Grande" Tag="1.15" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Capsule" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TintCheck" Content="Teinter la capsule selon la pochette"
                                      Checked="Options_Changed" Unchecked="Options_Changed" />
                            <CheckBox x:Name="CompactTemperatureCheck" Content="Afficher la température à côté de l'heure"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="PrivacyIndicatorsCheck" Content="Signaler l'usage du micro et de la caméra"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="ContextualPageCheck" Content="À l'ouverture, afficher le minuteur s'il tourne, sinon le lecteur si la musique joue"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="WheelVolumeCheck" Content="Régler le volume à la molette sur la capsule fermée et sur la ligne du bas du panneau"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="PomodoroButtonCheck" Content="Afficher le bouton Pomodoro dans le minuteur"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="PomodoroMusicCheck" Content="Pomodoro : mettre la musique en pause pendant les pauses"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Délais et animations" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center" Text="Délai d'ouverture" />
                            <Slider x:Name="ExpandDelaySlider" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Minimum="0" Maximum="600" TickFrequency="50" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Délai d'ouverture"
                                    ValueChanged="Delay_ValueChanged" />
                            <TextBlock x:Name="ExpandDelayText" Grid.Column="2"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Délai de fermeture" />
                            <Slider x:Name="CollapseDelaySlider" Grid.Row="1" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Délai de fermeture"
                                    ValueChanged="Delay_ValueChanged" />
                            <TextBlock x:Name="CollapseDelayText" Grid.Row="1" Grid.Column="2"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Animations" />
                            <ComboBox x:Name="AnimationCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                      VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Animations"
                                      SelectionChanged="Animation_SelectionChanged">
                                <ComboBoxItem Content="Normales" Tag="1" />
                                <ComboBoxItem Content="Rapides" Tag="0.6" />
                                <ComboBoxItem Content="Désactivées" Tag="0" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Lecteur">
            <ScrollViewer Style="{StaticResource TabContent}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Lecteur par défaut" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ComboBox x:Name="PlayerCombo"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Lecteur par défaut"
                                      SelectionChanged="Player_Changed">
                                <ComboBoxItem Content="Deezer" Tag="deezer" />
                                <ComboBoxItem Content="Spotify" Tag="spotify" />
                                <ComboBoxItem Content="Apple Music" Tag="applemusic" />
                                <ComboBoxItem Content="Aucun : suivre Windows" Tag="" />
                            </ComboBox>
                            <CheckBox x:Name="PlayingOverPausedCheck"
                                      Margin="0,10,0,4"
                                      Content="Si ce lecteur est en pause, afficher celui qui joue"
                                      Checked="Player_Changed" Unchecked="Player_Changed" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Seules les applications sont reconnues : un site ouvert dans un navigateur apparaît sous le nom du navigateur." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Changement de morceau" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TrackBannerCheck"
                                      Content="Afficher le titre quand le morceau suivant commence"
                                      Checked="Player_Changed" Unchecked="Player_Changed" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="28,0,0,0"
                                       Text="Une petite bannière, pour le lecteur par défaut seulement. Windows et Deezer ne donnent pas la file d'attente : le titre ne peut pas être connu à l'avance." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Notifications">
            <ScrollViewer Style="{StaticResource TabContent}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Notifications Windows" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SystemNotificationsCheck"
                                      Content="Afficher les notifications de Windows dans la capsule"
                                      Checked="SystemNotifications_Changed" Unchecked="SystemNotifications_Changed" />
                            <TextBlock x:Name="SystemNotificationsStatusText" Style="{StaticResource Hint}" Margin="0,2,0,8" Visibility="Collapsed" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="Ouvrir les paramètres" Click="OpenNotificationSettings_Click" />
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="Pour ne plus les voir en bas à droite, activez « Ne pas déranger » (Win + N). Windows ne permet pas à une application de le faire à votre place." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Applications" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,6"
                                       Text="Décochez une application pour ne plus voir ses notifications dans la capsule. Une application apparaît ici à sa première notification." />
                            <StackPanel x:Name="NotificationAppsList" />
                            <TextBlock x:Name="NoNotificationAppsText" Style="{StaticResource Hint}" Text="Aucune notification reçue pour l'instant." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Heures de silence" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="QuietHoursCheck" Content="Ne pas afficher les notifications et les mails sur cette plage"
                                      Checked="QuietHours_Changed" Unchecked="QuietHours_Changed" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="De" />
                                <TextBox x:Name="QuietStartBox" Width="64" Margin="8,0,8,0" TextAlignment="Center"
                                         AutomationProperties.Name="Début du silence"
                                         LostFocus="QuietHours_Changed" />
                                <TextBlock VerticalAlignment="Center" Text="à" />
                                <TextBox x:Name="QuietEndBox" Width="64" Margin="8,0,8,0" TextAlignment="Center"
                                         AutomationProperties.Name="Fin du silence"
                                         LostFocus="QuietHours_Changed" />
                                <TextBlock x:Name="QuietStatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Alertes de la capsule" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="FocusWithTimerCheck" Content="Masquer les notifications pendant un minuteur"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="NetworkAlertsCheck" Content="Alerter quand la connexion tombe ou revient"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                            <CheckBox x:Name="BatteryAlertsCheck" Content="Alertes batterie (PC, AirPods, chargeur)"
                                      Checked="CapsuleOptions_Changed" Unchecked="CapsuleOptions_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Mails">
            <ScrollViewer Style="{StaticResource TabContent}">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,10"
                                       Text="Ilot n'affiche que le nombre de non lus, l'expéditeur et le sujet. Pour permettre la mise à la corbeille, l'autorisation demandée à Google et Microsoft donne accès à la boîte mail ; elle reste chiffrée sur ce PC." />

                            <CheckBox x:Name="MailBannerCheck" Margin="0,0,0,12" Content="Afficher une bannière à l'arrivée d'un mail"
                                      Checked="MailEnabled_Changed" Unchecked="MailEnabled_Changed" />

                            <CheckBox x:Name="OutlookEnabledCheck" FontWeight="SemiBold" Content="Afficher Outlook"
                                      Checked="MailEnabled_Changed" Unchecked="MailEnabled_Changed" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2" Text="ID d'application (client)" />
                            <TextBox x:Name="OutlookIdBox" AutomationProperties.Name="ID Outlook" />
                            <DockPanel Margin="0,6,0,14">
                                <Button x:Name="OutlookButton" DockPanel.Dock="Right" MinWidth="96"
                                        AutomationProperties.Name="Compte Outlook"
                                        Click="OutlookButton_Click" />
                                <TextBlock x:Name="OutlookStatusText" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            </DockPanel>

                            <CheckBox x:Name="GmailEnabledCheck" FontWeight="SemiBold" Content="Afficher Gmail"
                                      Checked="MailEnabled_Changed" Unchecked="MailEnabled_Changed" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2" Text="ID client" />
                            <TextBox x:Name="GmailIdBox" AutomationProperties.Name="ID Gmail" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,2" Text="Code secret du client" />
                            <PasswordBox x:Name="GmailSecretBox" AutomationProperties.Name="Secret Gmail" />
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="GmailButton" DockPanel.Dock="Right" MinWidth="96"
                                        AutomationProperties.Name="Compte Gmail"
                                        Click="GmailButton_Click" />
                                <TextBlock x:Name="GmailStatusText" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            </DockPanel>

                            <CheckBox x:Name="Gmail2EnabledCheck" Margin="0,14,0,0" FontWeight="SemiBold" Content="Afficher le second compte Gmail"
                                      Checked="MailEnabled_Changed" Unchecked="MailEnabled_Changed" />
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="Gmail2Button" DockPanel.Dock="Right" MinWidth="96"
                                        AutomationProperties.Name="Second compte Gmail"
                                        Click="Gmail2Button_Click" />
                                <TextBlock x:Name="Gmail2StatusText" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Text="Mêmes identifiants que le premier compte : choisissez l'autre adresse à la connexion." />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Autre compte (IMAP)" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,0,0,8"
                                       Text="Le plus simple : aucun projet Google ou Azure à créer. Créez un mot de passe d'application dans la sécurité de votre compte (Gmail, Yahoo, iCloud…). Il reste chiffré sur ce PC. Outlook n'accepte plus cette méthode." />
                            <CheckBox x:Name="ImapEnabledCheck" FontWeight="SemiBold" Content="Afficher ce compte"
                                      Checked="MailEnabled_Changed" Unchecked="MailEnabled_Changed" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2" Text="Adresse mail" />
                            <TextBox x:Name="ImapAddressBox" AutomationProperties.Name="Adresse IMAP" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,2" Text="Mot de passe d'application" />
                            <PasswordBox x:Name="ImapPasswordBox" AutomationProperties.Name="Mot de passe IMAP" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,2" Text="Serveur (facultatif pour les services courants)" />
                            <TextBox x:Name="ImapHostBox" AutomationProperties.Name="Serveur IMAP" />
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="ImapButton" DockPanel.Dock="Right" MinWidth="96"
                                        AutomationProperties.Name="Compte IMAP"
                                        Click="ImapButton_Click" />
                                <TextBlock x:Name="ImapStatusText" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="À propos">
            <ScrollViewer Style="{StaticResource TabContent}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mises à jour" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Margin="0,0,0,8" />
                            <CheckBox x:Name="AutoUpdateCheck"
                                      Content="Chercher et télécharger les mises à jour automatiquement"
                                      Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="28,0,0,8"
                                       Text="Toutes les 6 heures, depuis les GitHub Releases du projet. Rien ne s'installe sans votre clic." />
                            <DockPanel>
                                <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="Rechercher" Click="CheckUpdate_Click" />
                                <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                                        Content="Installer et redémarrer"
                                        Visibility="Collapsed"
                                        Click="InstallUpdate_Click" />
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Dépannage" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ouvrir le journal" Click="OpenLog_Click" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Text="Le journal ne contient que les erreurs techniques, jamais le contenu de vos mails ou de votre note." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
