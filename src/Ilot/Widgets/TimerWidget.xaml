<UserControl x:Class="Ilot.Widgets.TimerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock x:Name="RemainingText"
                       FontSize="30" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="Minuteur" />
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Choisissez une durée" />
        </StackPanel>

        <StackPanel x:Name="SetupPanel" Grid.Column="1" VerticalAlignment="Center">
            <StackPanel x:Name="Presets" HorizontalAlignment="Right" Orientation="Horizontal" />
            <StackPanel Margin="0,6,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Border Width="56" Height="30"
                        Margin="0,0,2,0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10">
                    <Grid>
                        <TextBlock x:Name="MinutesHint"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="min" />
                        <TextBox x:Name="CustomMinutesBox"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 MaxLength="4"
                                 TextAlignment="Center"
                                 AutomationProperties.Name="Durée en minutes"
                                 PreviewMouseLeftButtonDown="CustomMinutesBox_PreviewMouseLeftButtonDown"
                                 PreviewKeyDown="CustomMinutesBox_PreviewKeyDown"
                                 PreviewTextInput="CustomMinutesBox_PreviewTextInput"
                                 TextChanged="CustomMinutesBox_TextChanged"
                                 KeyDown="CustomMinutesBox_KeyDown" />
                    </Grid>
                </Border>
                <Button Width="122" Height="30"
                        Margin="0,0,6,0"
                        FontSize="11"
                        Style="{StaticResource PillRowButton}"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Content="Lancer"
                        Click="StartCustom_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="RunningPanel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
            <Button x:Name="PauseButton"
                    Width="84" Height="30"
                    Margin="0,0,6,0"
                    FontSize="11"
                    Style="{StaticResource PillRowButton}"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Content="Pause"
                    Click="Pause_Click" />
            <Button Width="72" Height="30"
                    Margin="0,0,6,0"
                    FontSize="11"
                    Style="{StaticResource PillRowButton}"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Content="Arrêter"
                    Click="Stop_Click" />
        </StackPanel>
    </Grid>
</UserControl>
