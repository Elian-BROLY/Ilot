<UserControl x:Class="Ilot.Widgets.SystemWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="MuteButton"
                Width="24" Height="24"
                FontSize="13"
                Style="{StaticResource IconButton}"
                Content="&#xE767;"
                ToolTip="Couper / rétablir le son"
                Click="Mute_Click" />

        <Slider x:Name="VolumeSlider"
                Grid.Column="1"
                Margin="6,0"
                VerticalAlignment="Center"
                Style="{StaticResource ThinSlider}"
                Minimum="0" Maximum="1"
                IsMoveToPointEnabled="True"
                ValueChanged="VolumeSlider_ValueChanged" />

        <TextBlock x:Name="VolumeText"
                   Grid.Column="2"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel x:Name="BatteryPanel"
                    Grid.Column="3"
                    Margin="6,0,0,0"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
            <TextBlock x:Name="BatteryChargingGlyph"
                       Margin="0,0,1,0"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource IconFont}" FontSize="10"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="&#xE945;" />
            <TextBlock x:Name="BatteryGlyph"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="BatteryText"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
