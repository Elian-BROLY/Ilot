<UserControl x:Class="Ilot.Widgets.ClipboardWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="EmptyText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Copiez du texte ou une image : les derniers éléments s'affichent ici. Rien n'est enregistré sur le disque." />
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
            <StackPanel x:Name="Items" />
        </ScrollViewer>
    </Grid>
</UserControl>
