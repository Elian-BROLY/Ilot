<UserControl x:Class="Ilot.Widgets.QuickActionsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <UniformGrid Rows="1" Margin="0,8,4,8">
        <Button x:Name="WifiButton" Style="{StaticResource Tile}" IsEnabled="False"
                AutomationProperties.Name="Wi-Fi" Click="Wifi_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE701;" />
                <TextBlock Style="{StaticResource TileLabel}" Text="Wi-Fi" />
            </StackPanel>
        </Button>
        <Button x:Name="BluetoothButton" Style="{StaticResource Tile}" IsEnabled="False"
                AutomationProperties.Name="Bluetooth" Click="Bluetooth_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE702;" />
                <TextBlock Style="{StaticResource TileLabel}" Text="Bluetooth" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource Tile}" ToolTip="Ouvre les paramètres de Windows : aucune application ne peut le changer elle-même"
                AutomationProperties.Name="Mode avion" Click="Airplane_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE709;" />
                <TextBlock Style="{StaticResource TileLabel}" Text="Mode avion" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource Tile}" AutomationProperties.Name="Capture d'écran" Click="Capture_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8C6;" />
                <TextBlock Style="{StaticResource TileLabel}" Text="Capture" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource Tile}" AutomationProperties.Name="Verrouiller le PC" Click="Lock_Click">
            <StackPanel>
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE72E;" />
                <TextBlock Style="{StaticResource TileLabel}" Text="Verrouiller" />
            </StackPanel>
        </Button>
    </UniformGrid>
</UserControl>
