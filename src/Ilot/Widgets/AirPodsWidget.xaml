<UserControl x:Class="Ilot.Widgets.AirPodsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Ilot.Controls">
    <UserControl.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Height="40"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="10">
        <Grid Margin="10,0,7,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Width="22" Height="22"
                  Data="{StaticResource AirPodsGeometry}"
                  Fill="{DynamicResource TextPrimaryBrush}"
                  Stretch="Uniform" />

            <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusText"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <controls:AirPodsBatteryRings x:Name="Rings"
                                          Grid.Column="2"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />

            <Button x:Name="ActionButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Style="{StaticResource PillButton}"
                    Click="Action_Click" />
        </Grid>
    </Border>
</UserControl>
